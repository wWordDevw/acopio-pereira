# Copia a .env para local. En Dokploy: Environment del compose api-persistente.
# Nunca commitees .env. Los secretos van solo en Dokploy.

# --- API (servicio api) ---
# Dígitos del chip público para el botón wa.me (sin +).
WHATSAPP_PUBLIC_NUMBER=

# --- Transporte WhatsApp (servicio bot) ---
# waha | meta. Default waha. No pongas meta hasta tener las cuatro META_*.
WHATSAPP_PROVIDER=waha

# WAHA (activo mientras WHATSAPP_PROVIDER=waha)
WAHA_API_KEY=
WAHA_SESSION=
WEBHOOK_SECRET=

# Meta Cloud API (activo solo si WHATSAPP_PROVIDER=meta)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# LLM fallback (sin key: el bot pregunta a palo seco)
LLM_API_KEY=
